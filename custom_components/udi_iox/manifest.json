{
  "domain": "udi_iox",
  "name": "Universal Devices IoX (eisy / Polisy)",
  "codeowners": ["@shbatm"],
  "config_flow": true,
  "dhcp": [
    {
      "registered_devices": true
    },
    {
      "hostname": "eisy*",
