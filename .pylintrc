[MASTER]
# Minimal pylintrc to satisfy pre-commit pylint hook.
ignore=tests

[MESSAGES CONTROL]
# Disable conventions that are noisy for this project.
disable=
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    too-many-instance-attributes,
    too-many-branches,
    unused-argument,
    too-many-statements,
    superfluous-parens,
    too-many-lines,
    line-too-long,
    useless-return,
    too-many-public-methods,
    too-many-arguments,
    duplicate-code,
    too-many-return-statements,
    too-many-positional-arguments,
    too-many-locals,
    # ``ToggleEntity``/etc. abstract sync methods are overridden by their
    # async counterparts (the canonical HA pattern); pylint can't see this.
    abstract-method,
    # E1120/E1123 mis-fire on the v6 entity mixin hierarchy + dataclass
    # ``EntityDescription`` kwargs; mypy is authoritative for those.
    no-value-for-parameter,
    unexpected-keyword-arg,
    # ``service_info.{dhcp,ssdp}`` was added to HA in mid-2025; older HA
    # versions on developer machines don't expose the submodules even
    # though they exist at consumer-runtime.
    import-error,
    no-name-in-module
